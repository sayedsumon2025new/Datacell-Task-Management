{
  "name": "datacell-task-management",
  "account_id": "7813d05dfb2f624fe8c9e668ad70c200",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/functions/*",
      "/auth/*",
      "/rest/*",
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "datacell-task-db",
      "database_id": "b0d3c7ee-3dfc-4cdf-81a8-05312bb060df",
      "migrations_dir": "cloudflare/migrations"
    }
  ]
}
